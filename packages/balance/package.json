{
  "name": "@sumomok/dsh-balance",
  "description": "Account balance and spend for the DeepSeek Harness web GUI: a sidebar chip that follows the current session's provider, a provider picker over the providers this deployment can currently show a balance for, and per-session/today/month/all-time spend priced from a deployment-owned price table",
  "version": "0.4.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/types/typert.d.ts",
      "default": "./lib/typert.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "balance",
    "spend"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumomok/dsh-plugins.git",
    "directory": "packages/balance"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.2-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.2-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.2-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.1.2-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.2-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.2-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-session-projection": ">=0.1.2-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.2-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2-alpha.2 <0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
