{
  // Declaration-only project: `build.mjs` owns both runtime artifacts
  // (esbuild), so tsc emits nothing but `lib/types/**`. The root solution
  // references this project, so `pnpm run typecheck` at the workspace root
  // still type-checks the plugin's sources.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "emitDeclarationOnly": true,
    // Outside outDir so the published `lib/` carries only artifacts.
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node"]
  },
  "include": [
    "src"
  ]
}
